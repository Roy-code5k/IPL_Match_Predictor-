# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Raw data is downloaded from Kaggle, not committed (see docs/data_source.md)
data/raw/*.csv
data/raw/*.zip

# Frontend
app/frontend/node_modules/
app/frontend/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Processed CSVs are regenerated by `python -m src.data.cleaning` and `python -m src.features.builder`;
# the *manifest.json files (expected hashes) are committed.
data/processed/*.csv

# Model release 1.0.0 is tracked for deployment (under 2 MB total)
!models/release-1.0.0/*.joblib
!models/release-1.0.0/*.csv

# Prediction log written by the API (app/backend/store.py)
logs/
